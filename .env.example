# Copy this file to .env and fill in your values
API_BASE_URL=http://localhost:3000/api

# Google OAuth - Web Client ID from Google Cloud Console
# This MUST be the Web application OAuth client ID (not Android).
# The Android OAuth client (with SHA-1 fingerprint) must also exist
# in the same Google Cloud project for Android sign-in to work.
# Run: cd android && ./gradlew signingReport  to get the SHA-1.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
